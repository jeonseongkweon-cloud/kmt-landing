<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/navy" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="계명태권도 CLASS" android:textColor="@color/gold" android:textStyle="bold" android:textSize="15sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="문자 발신기" android:textColor="@color/white" android:textStyle="bold" android:textSize="34sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLASS v0.9.0 · Android SIM · NO LOGIN" android:textColor="@color/muted" android:layout_marginBottom="20dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="발신기 상태" android:textColor="@color/muted"/><TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFF" android:textColor="@color/gold" android:textStyle="bold" android:textSize="30sp"/><TextView android:id="@+id/accountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="로그인 없이 자동 연결" android:textColor="@color/white" android:layout_marginTop="8dp"/><TextView android:id="@+id/serverText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="서버 연결 확인 중" android:textColor="@color/muted"/><TextView android:id="@+id/todayText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘 발송: 0건" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="16dp"/><TextView android:id="@+id/lastText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="마지막 발송: 없음" android:textColor="@color/muted" android:layout_marginTop="5dp"/></LinearLayout>
<Button android:id="@+id/toggleButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="발신기 ON" android:textStyle="bold" android:enabled="false" android:layout_marginTop="18dp"/><Button android:id="@+id/batteryButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="배터리 최적화 제외 설정" android:layout_marginTop="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="운영 안내\n• Google 로그인 없이 자동으로 서버에 연결됩니다.\n• 화면이 꺼져도 알림창의 발신기 서비스가 유지됩니다.\n• 발신기 OFF 상태에서는 문자를 가져오지 않습니다.\n• 실패한 문자는 CLASS 대기함에서 재전송할 수 있습니다." android:textColor="@color/muted" android:lineSpacingExtra="5dp" android:layout_marginTop="20dp"/>
</LinearLayout></ScrollView>
